{
  "name": "open-opgg-desktop",
  "version": "2.0.0",
  "description": "Clean-room 1:1 open-source replica of OP.GG for Desktop (League of Legends)",
  "main": "main/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check": "node tools/check-syntax.mjs .",
    "test": "node tools/test-core.mjs",
    "verify": "node tools/verify-pages.mjs",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir",
    "dist:portable": "electron-builder --win portable"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/1khvled/FREE-OPGG.git"
  },
  "build": {
    "appId": "com.openopgg.desktop",
    "productName": "OP.GG Desktop OpenSource",
    "copyright": "Copyright © 2026 Open Source Community",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "preload/**/*",
      "shared/**/*",
      "src/**/*",
      "overlay/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OP.GG Desktop OpenSource",
      "artifactName": "OP.GG-Desktop-Setup-${version}.${ext}"
    }
  },
  "keywords": [
    "opgg",
    "leagueoflegends",
    "open-source"
  ],
  "author": "Open Source Community",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3"
  }
}
